{
  "kind": "preset",
  "schemaVersion": 1,
  "name": "colorblind-safe",
  "palette": {
    "background": "#ffffff",
    "text": "#111111",
    "mutedText": "#555555",
    "nodeFill": "#ffffff",
    "nodeBorder": "#333333",
    "edge": "#555555",
    "branchColors": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#56B4E9", "#D55E00"]
  },
  "roles": {
