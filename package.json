{
  "name": "mindmap-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-first mind map and brainstorming studio that runs in your browser, with an AI round trip through JSON files.",
  "keywords": [
    "mind-map",
    "mindmap",
    "brainstorming",
    "outliner",
    "pwa",
    "offline-first",
    "react",
    "react-flow",
    "llm"
  ],
  "homepage": "https://huduzhu.github.io/mindmap/",
  "bugs": {
    "url": "https://github.com/huduzhu/mindmap/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huduzhu/mindmap.git"
  },
  "author": "huduzhu",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/ensure-viewer.mjs",
    "dev": "vite --port 5173 --strictPort",
    "prestart": "node scripts/ensure-viewer.mjs",
    "start": "node scripts/start-dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "build": "tsc -b && npm run build:viewer && node scripts/copy-viewer.mjs && vite build",
    "package": "npm run build && node scripts/package-zip.mjs",
    "build:viewer": "vite build --config viewer.config.ts",
    "viewer": "node scripts/ensure-viewer.mjs",
    "icons": "node scripts/make-icons.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "validate": "node scripts/validate.mjs",
    "repair": "node scripts/repair-llm-output.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "validators": "node scripts/build-validators.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "bench": "node scripts/bench-edit.mjs"
  },
  "dependencies": {
    "@antv/hierarchy": "^0.7.1",
    "@xyflow/react": "^12.11.5",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "nanoid": "^6.0.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
